{
  "name": "@ts-fullstack-ts-grm/backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "db:dev": "tgm dev",
    "db:deploy": "tgm deploy",
    "db:status": "tgm status",
    "db:push": "tgm push",
    "db:check": "tgm check",
    "test:integration": "PG_INTEGRATION=1 bun test tests/integration"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@ts-grm/core": "0.0.13",
    "@ts-grm/sql": "0.0.13",
    "elysia": "^1.4.30",
    "pg": "8.23.0",
    "ts-grm-patches": "^0.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "8.20.0",
    "ts-grm-migrate": "0.1.0-alpha.4",
    "typescript": "^6.0.2"
  },
  "license": "Apache-2.0"
}
