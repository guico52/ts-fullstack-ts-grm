# 运行环境：development | test | production
NODE_ENV=development

# HTTP 监听端口
PORT=3000

# PostgreSQL 连接。password 留空表示无密码（本地 trust 认证）。
# 生产环境务必通过环境变量注入真实凭据，不要把密码写进仓库。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=ts_fullstack_ts_grm
PG_USER=postgres
PG_PASSWORD=

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# 接口文档开关；不设置时非 production 环境默认开启
# ENABLE_DOCS=true
