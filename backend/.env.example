# 运行环境：development | test | production
NODE_ENV=development

# HTTP 监听端口
PORT=3000

# PostgreSQL 连接。password 留空表示无密码（本地 trust 认证）。
# 生产环境务必通过环境变量注入真实凭据，不要把密码写进仓库。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=ts_fullstack_ts_grm
PG_USER=postgres
PG_PASSWORD=

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# 初始管理员。每次启动时检查：若不存在名为 admin 的账号，就用这两个值创建。
# 只影响“创建”那一次——之后改密码不会被这里覆盖（改名会让它重新跑）。
# 生产环境务必改掉，并通过环境变量注入，不要写进仓库。
ADMIN_EMAIL=admin@example.com
ADMIN_PWD=change-me-before-deploying

# JWT 签名密钥。开发环境可以留空（会用内置默认值，并在启动时警告）；
# **生产环境必须设置** —— 用一个公开的默认值签发凭据，等于谁都能伪造 token。
JWT_SECRET=

# 接口文档开关；不设置时非 production 环境默认开启
# ENABLE_DOCS=true
